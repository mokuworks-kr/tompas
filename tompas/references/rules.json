        "margin.inner":  {"name": "안쪽 여백. 제본에 먹히는 폭을 뺀, 눈에 보이는 값", "unit": "mm", "by": "테마"},
        "margin.top":    {"name": "위 여백. 쪽번호와 머리글은 이 안에 둔다", "unit": "mm", "by": "테마"},
        "margin.outer":  {"name": "바깥 여백. 쪽번호와 머리글은 이 안에 둔다", "unit": "mm", "by": "테마"},
        "margin.bottom": {"name": "아래 여백. 쪽번호와 머리글은 이 안에 둔다", "unit": "mm", "by": "테마"},
        "page.ratio":    {"name": "판형 비율, 폭 ÷ 높이", "by": "계산"},
        "text.ratio":    {"name": "판면 비율, 폭 ÷ 높이", "by": "계산"},
        "text.share":    {"name": "쪽 면적 중 판면의 비율", "by": "계산"},
        "pages":         {"name": "쪽수", "unit": "쪽", "by": "문서"},
        "margin.bind":   {"name": "제본에 먹히는 폭", "unit": "mm", "by": "문서"},
        "margin.ends":   {"name": "위·아래 여백 중 넓은 값", "unit": "mm", "by": "계산"},
        "margin.sides":  {"name": "안쪽·바깥 여백 중 넓은 값", "unit": "mm", "by": "계산"}
      },
      "rules": [
        {"id": "P1", "rule": "판면은 판형과 같은 비율이다.", "kind": "점수", "rel": "ratio", "args": ["text.ratio", "page.ratio"], "value": {"min": 0.9, "max": 1.1}, "src": "측정", "scope": "테마별", "from": "반 더 그라프"},
        {"id": "P2", "rule": "위나 아래 여백이 가장 넓다. 좌우는 그보다 좁다.", "kind": "점수", "rel": "ratio", "args": ["margin.ends", "margin.sides"], "value": {"min": 1}, "src": "측정", "scope": "테마별", "from": "반 더 그라프, 아카이브"},
        {"id": "P3", "rule": "판면은 쪽 면적의 일정 비율을 차지한다.", "kind": "공식", "rel": "range", "args": ["text.share"], "value": {"min": 0.6, "max": 0.8}, "src": "측정", "scope": "테마별", "from": "고전 판면 비례"},
        {"id": "P4", "rule": "제본에 먹히는 폭은 쪽수에 비례해 안쪽에 더한다.", "kind": "공식", "rel": "ratio", "args": ["margin.bind", "pages"], "from": "제본 실무, 인쇄소 기준"}
      ]
    },
    {
      "id": "T", "name": "글자",
      "vars": {
        "body.size":    {"name": "본문 크기", "unit": "pt", "by": "테마"},
        "body.leading": {"name": "본문 행간", "unit": "pt", "by": "테마"},
        "scale.ratio":  {"name": "크기 척도의 비율", "by": "테마"},
        "sizes":        {"name": "쓰인 글자 크기들", "unit": "pt", "by": "조판"},
        "sizes.n":      {"name": "쓰인 크기의 가짓수", "unit": "개", "by": "계산"},
        "families":     {"name": "쓰인 서체 가족 수", "unit": "개", "by": "조판"},
        "measure":      {"name": "본문 한 줄 글자 수, 공백 포함", "unit": "자", "by": "조판", "at": "문단"},
        "title.step":   {"name": "제목 크기(본문의 1.15배 이상)끼리 이웃한 크기 비율 중 가장 작은 값", "by": "계산"}
      },
      "rules": [
        {"id": "T1", "rule": "본문 크기는 범위 안에서 고른다.", "kind": "공식", "rel": "range", "args": ["body.size"], "value": {"min": 7.5, "max": 9.2}, "src": "측정", "from": "브링허스트, 아카이브 인쇄"},
        {"id": "T2", "rule": "본문 행간은 본문 크기에 비례한다.", "kind": "공식", "rel": "ratio", "args": ["body.leading", "body.size"], "value": {"한글": {"min": 1.56, "max": 1.81}, "일본어": {"min": 1.62, "max": 1.88}, "라틴": {"min": 1.28, "max": 1.6}}, "src": "측정", "from": "브링허스트, 한글 보정"},
        {"id": "T3", "rule": "본문 한 줄 글자 수는 범위 안에 든다.", "kind": "점수", "rel": "range", "args": ["measure"], "value": {"한글": {"min": 34, "max": 55}, "일본어": {"min": 25, "max": 28}, "라틴": {"min": 44, "max": 66}}, "src": "측정", "from": "브링허스트, 한글 보정"},
        {"id": "T4", "rule": "글자 크기는 한 척도에서만 고른다.", "kind": "체크", "rel": "scale", "args": ["sizes", "scale.ratio"], "from": "브링허스트"},
        {"id": "T5", "rule": "제목 크기끼리는 단호하게 띄운다. 본문보다 작은 글은 가까운 크기를 여럿 써도 된다.", "kind": "점수", "rel": "range", "args": ["title.step"], "value": {"min": 1.1}, "src": "가설", "scope": "테마별", "from": "비녤리, 아카이브"},
        {"id": "T6", "rule": "쓰는 크기는 몇 단계뿐이다.", "kind": "체크", "rel": "range", "args": ["sizes.n"], "value": {"max": 11}, "src": "측정", "scope": "테마별", "from": "비녤리"},
        {"id": "T7", "rule": "서체 가족은 둘을 짝으로 쓰고, 셋째는 감초로만 더한다.", "kind": "체크", "rel": "range", "args": ["families"], "value": {"max": 3}, "src": "측정", "from": "비녤리"}
      ]
    },
    {
      "id": "G", "name": "격자",
