{
  "version": 1,
  "about": "TOMPAS 규칙. 층은 위에서 아래로 계산하고, 규칙은 자기 층과 위층의 변수만 쓴다. 규칙 하나는 관계 하나다.",

  "fields": {
    "kind": {
      "공식": "값을 정한다. 엔진과 테마가 범위 안에서 고른다.",
      "체크": "통과와 실패를 가른다.",
      "점수": "범위를 벗어난 만큼 감점한다.",
      "가이드": "LLM이 판단한다. 관계가 없다."
    },
    "rel": {
      "range": "a가 범위 안에 든다.",
      "ratio": "a ÷ b가 범위 안에 든다.",
      "multiple": "a가 b의 정수배다. 값은 배수의 범위.",
      "order": "앞에 적은 값일수록 작다.",
      "snap": "a의 위치가 b의 선 위에 있다.",
      "scale": "a의 값들이 b를 비율로 하는 등비수열 위에 있다.",
      "run": "a에서 같은 값이 이어지는 길이. 값은 최대 길이."
    },
    "value": "범위 {min, max}. 문자마다 다르면 {한글, 일본어, 라틴}으로 나눈다.",
    "src": {
      "가설": "책이나 결정에서 온 값. 아카이브로 검증한다.",
      "측정": "아카이브에서 잰 값.",
      "정의": "규칙의 뜻 자체라 재지 않는 값."
    },
    "scope": {
      "보편": "늘 지킨다.",
      "테마별": "테마에 따라 뒤집힐 수 있다."
    },
    "tag": {
      "취향": "시스템의 성격을 정한다.",
      "임시": "모델의 약점을 메운다. 지울 대상이다."
    },
    "by": {
      "문서": "프로젝트가 정한다.",
      "테마": "테마가 정한다.",
      "와이어프레임": "LLM이 와이어프레임으로 정한다.",
      "조판": "InDesign 결과에서 잰다.",
      "계산": "엔진이 위의 변수로 계산한다."
    },
    "at": {
      "문서": "문서에 하나.",
      "스프레드": "스프레드마다.",
      "쪽": "쪽마다.",
      "문단": "문단마다.",
      "요소": "글 덩어리·사진·도형마다."
    }
  },

  "defaults": {"var": {"at": "문서"}, "rule": {"value": null, "scope": "보편", "tag": "취향"}},

