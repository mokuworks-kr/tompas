        "row.h":      {"name": "필드 높이", "unit": "pt", "by": "계산"},
        "row.gap":    {"name": "필드 사이", "unit": "pt", "by": "계산"},
        "col.n":      {"name": "단 수", "unit": "개", "by": "테마"},
        "col.gutter": {"name": "단 사이", "unit": "mm", "by": "테마"},
        "fields":     {"name": "필드선 위치", "unit": "mm", "by": "계산"},
        "baselines":  {"name": "기준선 위치", "unit": "mm", "by": "계산"},
        "lines":      {"name": "기준선과 첫 줄 글자 윗선 위치", "unit": "mm", "by": "계산"}
      },
      "rules": [
        {"id": "G1", "rule": "모든 행간은 기준선의 정수배다.", "kind": "공식", "rel": "multiple", "args": ["leadings", "baseline"], "scope": "테마별", "from": "뮐러브로크만"},
        {"id": "G2", "rule": "필드 높이는 기준선의 정수배다.", "kind": "공식", "rel": "multiple", "args": ["row.h", "baseline"], "from": "뮐러브로크만"},
        {"id": "G3", "rule": "필드 사이는 기준선 한 줄이다.", "kind": "공식", "rel": "multiple", "args": ["row.gap", "baseline"], "value": {"min": 1, "max": 1}, "src": "가설", "from": "뮐러브로크만"},
        {"id": "G4", "rule": "단 사이는 기준선에 비례한다.", "kind": "공식", "rel": "ratio", "args": ["col.gutter", "baseline"], "value": {"min": 1.2, "max": 2.9}, "src": "측정", "scope": "테마별", "from": "뮐러브로크만"},
        {"id": "G5", "rule": "단 수는 범위 안에서 고른다.", "kind": "공식", "rel": "range", "args": ["col.n"], "value": {"min": 1, "max": 4}, "src": "측정", "scope": "테마별", "from": "뮐러브로크만"}
      ]
    },
    {
      "id": "H", "name": "한글",
      "vars": {
        "breaks.midword": {"name": "어절 중간에서 바뀐 줄 수", "unit": "개", "by": "조판"},
        "kinsoku":        {"name": "줄 머리와 꼬리의 금칙 위반 수", "unit": "개", "by": "조판"},
        "lastline.chars": {"name": "문단 끝줄 글자 수", "unit": "자", "by": "조판", "at": "문단"},
        "widows":         {"name": "다음 단으로 홀로 넘어간 문단 끝줄 수", "unit": "개", "by": "조판"},
        "title.splits":   {"name": "의미 덩어리 안에서 바뀐 제목 줄 수", "unit": "개", "by": "조판"}
      },
      "rules": [
        {"id": "H1", "rule": "줄은 어절 단위로 바꾼다.", "kind": "체크", "rel": "range", "args": ["breaks.midword"], "value": {"max": 0}, "src": "정의", "from": "한글 조판 관습"},
        {"id": "H2", "rule": "줄 머리와 꼬리에 금칙 문자를 두지 않는다.", "kind": "체크", "rel": "range", "args": ["kinsoku"], "value": {"max": 0}, "src": "정의", "from": "한글 조판 관습"},
        {"id": "H3", "rule": "문단 끝줄을 한두 글자로 남기지 않는다.", "kind": "체크", "rel": "range", "args": ["lastline.chars"], "value": {"min": 3}, "src": "측정", "from": "한글 조판 관습"},
        {"id": "H4", "rule": "문단 끝줄 하나만 다음 단으로 넘기지 않는다.", "kind": "체크", "rel": "range", "args": ["widows"], "value": {"max": 0}, "src": "정의", "from": "브링허스트"},
        {"id": "H5", "rule": "제목은 의미 덩어리 사이에서만 줄을 바꾼다.", "kind": "체크", "rel": "range", "args": ["title.splits"], "value": {"max": 0}, "src": "정의", "from": "한글 조판 관습"}
      ]
    },
    {
      "id": "C", "name": "색",
      "vars": {
        "accents":    {"name": "강조색 수", "unit": "개", "by": "테마"},
        "tone.text":  {"name": "글자와 바탕의 명도 차", "unit": "L*", "by": "테마"},
        "tone.shift": {"name": "색을 입힌 뒤 색 역할의 명도가 흑백 계획에서 벗어난 정도", "unit": "L*", "by": "계산"}
      },
      "rules": [
        {"id": "C1", "rule": "강조색은 하나다.", "kind": "체크", "rel": "range", "args": ["accents"], "value": {"max": 1}, "src": "가설", "scope": "테마별", "from": "비녤리"},
        {"id": "C2", "rule": "색을 입혀도 색 역할의 명도는 흑백 계획 그대로다.", "kind": "체크", "rel": "range", "args": ["tone.shift"], "value": {"max": 10}, "src": "가설", "from": "결정 D-11"},
        {"id": "C3", "rule": "본문 글자는 바탕과 충분히 대비된다.", "kind": "체크", "rel": "range", "args": ["tone.text"], "value": {"min": 60}, "src": "측정", "from": "가독성"}
      ]
    },
    {
      "id": "L", "name": "배치",
      "vars": {
        "frames":      {"name": "프레임 모서리 위치", "unit": "mm", "by": "조판", "at": "스프레드"},
        "firstlines":  {"name": "글 첫 줄 위치", "unit": "mm", "by": "조판", "at": "스프레드"},
        "images":      {"name": "사진 윗선과 아랫선 위치", "unit": "mm", "by": "조판", "at": "스프레드"},
        "gap.side":    {"name": "양쪽 이웃이 모두 성격(글은 크기나 서체, 그림은 크기)이 다른 요소의 넓은 쪽 간격 ÷ 좁은 쪽 간격. 글·사진·도형을 모두 요소로 보고, 괘선이나 바탕이 경계를 정한 곳은 재지 않는다", "by": "조판", "at": "요소"},
        "align.lines": {"name": "정렬선 수", "unit": "개", "by": "조판", "at": "스프레드"},
        "balance":     {"name": "좌우 무게 차, 0이면 같다", "by": "조판", "at": "스프레드"},
        "heroes":      {"name": "주인공 수. *를 단 영역 중 같은 종류(사진끼리, 글끼리)에 1.5배 넘게 무거운 요소가 없는 것만 센다. 무게는 사진이 면적, 글이 가장 큰 글자 크기. 흐르는 본문만 있는 스프레드는 재지 않는다", "unit": "개", "by": "와이어프레임", "at": "스프레드"},
        "areas":       {"name": "영역 수", "unit": "개", "by": "와이어프레임", "at": "쪽"},
        "space.lump":  {"name": "가장 큰 빈 덩어리 ÷ 전체 빈 면적. 1이면 빈 곳이 한 덩어리", "by": "와이어프레임", "at": "스프레드"},
        "rows.share":  {"name": "옆에 비슷한 높이(20mm 안)로 시작하는 묶음이 있는 큰 요소가 윗선이나 아랫선을 다른 요소와 함께 쓰면 1, 아니면 0. 쪽 위아래 끝도 선이다", "by": "조판", "at": "요소"}
      },
      "rules": [
        {"id": "L1", "rule": "프레임 모서리는 필드선 위에 있다.", "kind": "체크", "rel": "snap", "args": ["frames", "fields"], "from": "뮐러브로크만"},
        {"id": "L2", "rule": "글 첫 줄은 기준선 위에 있다.", "kind": "체크", "rel": "snap", "args": ["firstlines", "baselines"], "from": "뮐러브로크만"},
        {"id": "L3", "rule": "사진 윗선은 옆 단 첫 줄의 글자 윗선에, 아랫선은 기준선에 맞춘다.", "kind": "체크", "rel": "snap", "args": ["images", "lines"], "from": "뮐러브로크만"},
        {"id": "L4", "rule": "요소는 이웃 중 한쪽에 확실히 붙는다. 양쪽 간격이 비슷한 어중간한 자리를 두지 않는다.", "kind": "점수", "rel": "range", "args": ["gap.side"], "value": {"min": 1.5}, "src": "측정", "from": "게슈탈트 근접성, 결정 D-34"},
        {"id": "L5", "rule": "정렬선은 적을수록 좋다.", "kind": "점수", "rel": "range", "args": ["align.lines"], "value": {"max": 9}, "src": "측정", "from": "뮐러브로크만"},
        {"id": "L6", "rule": "스프레드마다 주인공은 하나다.", "kind": "점수", "rel": "range", "args": ["heroes"], "value": {"min": 1, "max": 1}, "src": "가설", "from": "비녤리"},
        {"id": "L7", "rule": "스프레드의 좌우 무게는 균형을 이룬다.", "kind": "점수", "rel": "range", "args": ["balance"], "value": {"max": 0.25}, "src": "측정", "scope": "테마별", "from": "결정 D-15"},
